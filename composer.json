{
    "name": "99x/craft-swish-suite",
    "description": "Craft CMS plugin for Swish payment integration",
    "type": "craft-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "craftcms/cms": "^5.0",
        "guzzlehttp/guzzle": "^7.0",
        "ramsey/uuid": "^4.0",
        "endroid/qr-code": "^5.0"
    },
    "require-dev": {
        "craftcms/commerce": "^5.0",
        "phpunit/phpunit": "^10.0",
        "craftcms/ecs": "dev-main",
        "friendsofphp/php-cs-fixer": "^3.20",
        "symplify/easy-coding-standard": "^10.3",
        "craftcms/phpstan": "dev-main",
        "composer/pcre": "~3.3.2"
    },
    "suggest": {
        "craftcms/commerce": "^5.0 — Required to use Swish Suite as a Commerce payment gateway"
    },
    "scripts": {
        "check-cs": "ecs check --ansi",
        "fix-cs": "ecs check --ansi --fix",
        "phpstan": "phpstan --memory-limit=1G",
        "unit": "phpunit",
        "integration": "phpunit -c phpunit.integration.xml",
        "test": "@unit",
        "check": [
            "@check-cs",
            "@phpstan",
            "@unit",
            "@integration"
        ]
    },
    "autoload": {
        "psr-4": {
            "NinetyNineX\\SwishSuite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NinetyNineX\\SwishSuite\\Tests\\": "tests/"
        }
    },
    "extra": {
        "name": "Swish Suite",
        "handle": "swish-suite",
        "developer": "99x",
        "developerUrl": "https://99x.se",
        "class": "NinetyNineX\\SwishSuite\\SwishSuite",
        "schemaVersion": "1.0.0"
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    }
}
