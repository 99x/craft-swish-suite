{% extends "_layouts/cp" %}

{% set title = "Swish Payments" %}
{% set selectedSubnavItem = "payments" %}

{% block content %}
<div style="margin-bottom: 16px;">
    <a class="btn submit" href="{{ cpUrl('swish-suite/payments/new') }}">Create Payment</a>
</div>

<form method="get" accept-charset="UTF-8" class="pane" style="margin-bottom: 20px;">
    <div class="flex" style="gap: 12px; flex-wrap: wrap;">
        <input class="text fullwidth" type="text" name="paymentId" placeholder="Payment ID" value="{{ filters.paymentId }}">
        <input class="text fullwidth" type="text" name="reference" placeholder="Merchant reference" value="{{ filters.reference }}">
        <select name="status">
            <option value="">All statuses</option>
            {% for status in ['CREATED', 'PAID', 'DECLINED', 'CANCELLED', 'ERROR'] %}
                <option value="{{ status }}" {{ filters.status == status ? 'selected' }}>{{ status }}</option>
            {% endfor %}
        </select>
        <select name="flow">
            <option value="">All flows</option>
            {% for flow in ['ecommerce', 'mcommerce'] %}
                <option value="{{ flow }}" {{ filters.flow == flow ? 'selected' }}>{{ flow }}</option>
            {% endfor %}
        </select>
        <input class="text" type="date" name="dateFrom" value="{{ filters.dateFrom }}">
        <input class="text" type="date" name="dateTo" value="{{ filters.dateTo }}">
        <button class="btn submit" type="submit">Filter</button>
        <a class="btn" href="{{ cpUrl('swish-suite/payments') }}">Reset</a>
    </div>
</form>

{% if payments %}
    <p style="color: #666; margin-bottom: 8px;">
        Showing {{ payments|length }} of {{ totalCount }} payment{{ totalCount != 1 ? 's' }} — page {{ page }} of {{ totalPages }}
    </p>
    <table class="data fullwidth">
        <thead>
            <tr>
                <th>Payment ID</th>
                <th>Reference</th>
                <th>Amount</th>
                <th>Flow</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            {% for payment in payments %}
                <tr>
                    <td><a href="{{ cpUrl('swish-suite/payments/' ~ payment.id) }}">{{ payment.paymentId|slice(0, 8) }}...</a></td>
                    <td>{{ payment.payeePaymentReference ?: '—' }}</td>
                    <td>{{ payment.amount|swishSek(payment.currency) }}</td>
                    <td>{{ payment.flow ?: '—' }}</td>
                    <td><span class="status {{ payment.status == 'PAID' ? 'green' : (payment.status == 'CREATED' ? 'orange' : 'red') }}"></span>{{ payment.status }}</td>
                    <td>{{ payment.dateCreated|date('Y-m-d H:i') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% if totalPages > 1 %}
        <div class="flex" style="gap: 8px; margin-top: 16px; align-items: center;">
            {% if page > 1 %}
                <a class="btn" href="{{ cpUrl('swish-suite/payments', filters|merge({page: page - 1})) }}">&larr; Previous</a>
            {% endif %}
            <span>Page {{ page }} of {{ totalPages }}</span>
            {% if page < totalPages %}
                <a class="btn" href="{{ cpUrl('swish-suite/payments', filters|merge({page: page + 1})) }}">Next &rarr;</a>
            {% endif %}
        </div>
    {% endif %}
{% else %}
    <p>No payments matched the current filters.</p>
{% endif %}
{% endblock %}
